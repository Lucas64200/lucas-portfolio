# Copie ce fichier en .env.local et remplis les valeurs pour activer le formulaire de contact.

# Clé API Resend (https://resend.com) — pour l'envoi d'emails depuis le formulaire de contact.
RESEND_API_KEY=

# Adresse email qui reçoit les messages du formulaire de contact.
CONTACT_EMAIL=monvoisin.lucas@gmail.com
